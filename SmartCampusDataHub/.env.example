# Database Configuration
# Options: 'sqlite' or 'postgresql'
DB_TYPE=sqlite

# For SQLite - path to database file
DB_PATH=./data/smart_campus.db

# For PostgreSQL - uncomment and configure if using PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=smart_campus

# Logging
LOG_LEVEL=INFO

# Pipeline
CHUNK_SIZE=1000
VALIDATION_STRICT_MODE=False
